# CRM Portal Node.js & MongoDB Atlas Configuration

PORT=5000

# Replace the URI below with your MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-url>/crm_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:AdminPass123@cluster0.mongodb.net/crm_portal?retryWrites=true&w=majority

# JWT Settings
JWT_SECRET=supersecretjwtkey_crm_portal_2026_secured
JWT_EXPIRE=7d

# CORS
FRONTEND_URL=http://localhost:5173
